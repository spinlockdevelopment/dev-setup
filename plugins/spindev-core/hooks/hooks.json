{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/gh-workflow.sh"
          }
        ]
      }
    ]
  },
  "BeforeTool": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "${extensionPath}/hooks/scripts/gh-workflow.sh"
        }
      ]
    }
  ]
}
