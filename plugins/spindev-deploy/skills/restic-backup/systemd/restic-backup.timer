[Unit]
Description=Daily restic backup chain
Documentation=https://restic.net/

[Timer]
# Daily at 03:17. Weird minute so it doesn't collide with everyone-
# else's `0 3 * * *`. RandomizedDelaySec=1800 spreads further if
# multiple machines share this unit.
OnCalendar=*-*-* 03:17:00
RandomizedDelaySec=1800
Persistent=true
Unit=restic-backup.service

[Install]
WantedBy=timers.target
