# Cloudflare R2 credentials for restic. Copy to ~/.config/restic-backup/r2.env
# (chmod 600). The systemd service sources this file on every run.
#
# Mint these in the Cloudflare dashboard:
#   R2 → Manage R2 API Tokens → Create API token
#     - Permissions: Object Read & Write
#     - Specify bucket: <your bucket>          (scope to one bucket only)
#     - TTL: forever (rotate annually)
#
# Then EDIT the resulting token's permissions (or use the lower-level
# "Account API Token" with custom policy) to remove DeleteObject and
# DeleteObjectVersion. PutObject + GetObject + ListBucket only.
#
# Optional: enable R2 object lock on the bucket for compliance-mode
# WORM. With object lock, even Cloudflare-side deletes are refused
# until the retention period expires.

# S3-compatible endpoint for your account.
# Find your account ID at Cloudflare Dashboard → R2 → Overview.
AWS_ACCESS_KEY_ID="<r2-access-key-id>"
AWS_SECRET_ACCESS_KEY="<r2-secret-access-key>"

# R2 endpoint URL is computed from your account ID.
# https://<accountid>.r2.cloudflarestorage.com
R2_ACCOUNT_ID="<your-cloudflare-account-id>"
R2_BUCKET="<your-restic-bucket>"

# Restic computes the repo URL from these. Don't edit.
R2_REPO_URL="s3:https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com/${R2_BUCKET}"
