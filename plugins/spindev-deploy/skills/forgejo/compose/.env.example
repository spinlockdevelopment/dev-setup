# Forgejo container env. Copy to `.env` next to docker-compose.yml.

# Pinned LTS — bump when Forgejo LTS rolls (~yearly).
# pinned 2026-04-29
FORGEJO_VERSION=15.0.1

# Hostname users will clone from. Affects SSH/HTTPS clone URLs that
# Forgejo prints in the UI. For LAN-only use: the box's hostname.
FORGEJO_DOMAIN=localhost

# Host ports. Web UI on 3000, SSH on 2222 (avoid host-SSH collision).
WEB_PORT=3000
SSH_PORT=2222
